---
const base = import.meta.env.BASE_URL;
const logos = `${base}images/convenios`;

// logo: null → se muestra el nombre en texto hasta tener el archivo del logo
const insurers = [
  { name: "Colmédica", type: "Medicina prepagada", logo: `${logos}/colmedica.png` },
  { name: "Colsanitas", type: "Medicina prepagada", logo: `${logos}/colsanitas.png` },
  { name: "Medisanitas", type: "Medicina prepagada", logo: `${logos}/medisanitas.png` },
  { name: "Seguros de Vida Suramericana", type: "Póliza de salud SURA", logo: `${logos}/sura.svg` },
];
---

<section class="insurances" id="insurances">
  <div class="insurances__container">

    <div class="insurances__header insurances__animate">
      <p class="insurances__label">
        <span class="insurances__label-line"></span>
        CONVENIOS
      </p>
      <h1 class="insurances__title">
        Atención con tu<br />
        <em class="insurances__title-em">medicina prepagada y póliza de seguros</em>
      </h1>
      <p class="insurances__subtitle">
        Atiendo pacientes de las siguientes entidades. Al agendar tu cita, indícanos tu aseguradora
        y te confirmamos la cobertura de la consulta o procedimiento.
      </p>
    </div>

    <ul class="insurances__grid">
      {insurers.map((ins, i) => (
        <li class="insurances__card insurances__animate" style={`transition-delay: ${0.1 * (i + 1)}s`}>
          <div class="insurances__logo">
            {ins.logo ? (
              <img src={ins.logo} alt={`Logo de ${ins.name}`} loading="lazy" decoding="async" />
            ) : (
              <span class="insurances__wordmark">{ins.name}</span>
            )}
          </div>
          <div class="insurances__info">
            <p class="insurances__name">{ins.name}</p>
            <span class="insurances__type">{ins.type}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class="insurances__cta insurances__animate">
      <div>
        <p class="insurances__cta-title">¿Tu aseguradora no aparece en la lista?</p>
        <p class="insurances__cta-text">Escríbenos y te orientamos sobre las opciones de atención.</p>
      </div>
      <div class="insurances__cta-actions">
        <a href="https://wa.me/573026399527" target="_blank" class="insurances__btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Escribir por WhatsApp
        </a>
        <a href={base} class="insurances__link">Volver al inicio</a>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (() => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.insurances__animate').forEach((el) => observer.observe(el));
  })();
</script>

<style>
  .insurances {
    background: #f4f9fb;
    padding: 11rem 2.5rem 7rem;
    min-height: 80vh;
  }

  .insurances__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ── Header ── */
  .insurances__header {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 720px;
  }

  .insurances__label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: 'Georgia', serif;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: #c07a50;
    font-weight: 600;
    margin: 0;
  }

  .insurances__label-line {
    display: inline-block;
    width: 28px;
    height: 1.5px;
    background: #c07a50;
  }

  .insurances__title {
    font-family: 'Georgia', serif;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 700;
    color: #1a2f3a;
    line-height: 1.15;
    margin: 0;
  }

  .insurances__title-em {
    font-style: italic;
    font-weight: 400;
    color: #1a6faa;
  }

  .insurances__subtitle {
    font-family: 'Georgia', serif;
    font-size: 1rem;
    color: #4a6070;
    line-height: 1.8;
    margin: 0;
  }

  /* ── Tarjetas ── */
  .insurances__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .insurances__card {
    background: #fff;
    border: 1px solid #e0ecf2;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(26, 47, 58, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.7s ease;
  }

  .insurances__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(26, 47, 58, 0.1);
  }

  .insurances__logo {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #eef4f7;
  }

  .insurances__logo img {
    max-width: 100%;
    max-height: 64px;
    object-fit: contain;
  }

  .insurances__wordmark {
    font-family: 'Georgia', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #2c4a5a;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .insurances__info {
    padding: 1.3rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .insurances__name {
    font-family: 'Georgia', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #1a2f3a;
    margin: 0;
  }

  .insurances__type {
    font-family: 'Georgia', serif;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #1a6faa;
    background: #eaf4f8;
    border-radius: 20px;
    padding: 0.3rem 0.8rem;
  }

  /* ── CTA ── */
  .insurances__cta {
    background: #1a2f3a;
    border-radius: 16px;
    padding: 2rem 2.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .insurances__cta-title {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.3rem;
  }

  .insurances__cta-text {
    font-family: 'Georgia', serif;
    font-size: 0.92rem;
    color: #b8cad4;
    margin: 0;
  }

  .insurances__cta-actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-shrink: 0;
  }

  .insurances__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25d366;
    color: #fff;
    border-radius: 25px;
    padding: 0.8rem 1.5rem;
    font-family: 'Georgia', serif;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .insurances__btn:hover {
    background: #1ebe5b;
    transform: translateY(-1px);
  }

  .insurances__link {
    font-family: 'Georgia', serif;
    font-size: 0.92rem;
    color: #8cc4e8;
    text-decoration: none;
    padding: 0.6rem 0;
  }

  .insurances__link:hover {
    text-decoration: underline;
  }

  /* ── Animaciones ── */
  .insurances__animate {
    opacity: 0;
    transform: translateY(30px);
  }

  .insurances__header.insurances__animate,
  .insurances__cta.insurances__animate {
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .insurances__animate.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .insurances__card.visible:hover {
    transform: translateY(-4px);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .insurances__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 899px) {
    .insurances {
      padding: 10rem 1.5rem 4.5rem;
    }

    .insurances__title {
      font-size: clamp(2rem, 6vw, 2.8rem);
    }

    .insurances__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 479px) {
    .insurances__grid {
      gap: 0.75rem;
    }

    .insurances__logo {
      height: 96px;
      padding: 1rem;
    }

    .insurances__logo img {
      max-height: 40px;
    }

    .insurances__wordmark {
      font-size: 1.05rem;
    }

    .insurances__info {
      padding: 0.9rem 1rem 1rem;
    }

    .insurances__name {
      font-size: 0.85rem;
    }

    .insurances__type {
      font-size: 0.7rem;
      padding: 0.25rem 0.6rem;
    }

    .insurances__cta {
      padding: 1.6rem;
    }

    .insurances__cta-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 1rem;
    }

    .insurances__btn {
      justify-content: center;
    }

    .insurances__link {
      text-align: center;
    }
  }
</style>
