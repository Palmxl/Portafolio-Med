---
const stats = [
  { value: "2+", label: "ESPECIALIDADES" },
  { value: "100%", label: "COMPROMISO" },
  { value: "98%", label: "SATISFACCIÓN" },
  { value: "12+", label: "RECONOCIMIENTOS" },
];

const aboutPhotos = [
  "/Portafolio-Med/images/ABOUT.JPG",
  "/Portafolio-Med/images/about-2.jpg",
  "/Portafolio-Med/images/about-3.jpg",
  "/Portafolio-Med/images/about-4.jpg",
];

const credentialGroups = [
  {
    institution: "Universidad Militar Nueva Granada",
    items: [
      { title: "Médica y Cirujana", year: "2012" },
      { title: "Especialista en Otorrinolaringología", year: "2020" },
      { title: "Subespecialista en Laringología y Vía Aérea Superior", year: "2022" },
    ],
  },
  {
    institution: "Vocology Center",
    items: [
      { title: "Lorem ipsum dolor sit amet", year: "0000" },
    ],
  },
  {
    institution: "Miembro de número",
    items: [
      { title: "Asociación Colombiana de Otorrinolaringología, Cirugía de Cabeza y Cuello, Maxilofacial, Plástica y Estética Facial (ACORL)" },
    ],
  },
];
---

<section class="about" id="about">
  <div class="about__container">
    <div class="about__left about__animate about__animate--left">
      <p class="about__label">
        <span class="about__label-line"></span>
        SOBRE LA DOCTORA
      </p>
      <div class="about__img-wrapper">
        <div class="about__corner about__corner--tl"></div>
        <div class="about__corner about__corner--br"></div>
        {aboutPhotos.map((src, i) => (
          <img
            src={src}
            alt="Dra. Nathalia Sánchez"
            class={`about__img ${i === 0 ? "about__img--active" : "about__img--stacked"}`}
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
        <button type="button" class="about__arrow about__arrow--prev" aria-label="Foto anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="about__arrow about__arrow--next" aria-label="Foto siguiente">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="about__badge">
          <span class="about__badge-dot"></span>
          <div>
            <p class="about__badge-title">CERTIFICADA</p>
            <p class="about__badge-sub">Asociación Colombiana de ORL</p>
          </div>
        </div>
      </div>
    </div>

    <div class="about__right">
      <h2 class="about__title about__animate about__animate--1">
        Dedicada a tu<br />
        <em class="about__title-em">bienestar a largo plazo</em>
      </h2>

      <div class="about__divider about__animate about__animate--2"></div>

      <p class="about__text about__animate about__animate--3">
        Médica y cirujana especialista en otorrinolaringología con segunda especialidad en 
        laringología y vía aérea superior, de la Universidad Militar Nueva Granada. 
        Con gran compromiso en el ejercicio de su profesión y en la educación médica 
        continuada para brindar a sus pacientes una atención integral y con alto sentido humano.
      </p>

      <p class="about__text about__animate about__animate--4">
        Líder en el área de enfermedades que afectan la voz, deglución y respiración. 
        Actualmente miembro de la Asociación Colombiana de Otorrinolaringología y Cirugía 
        de cabeza y cuello, docente adjunta y especialista del Hospital Universitario San Ignacio.
      </p>

      <div class="about__stats about__animate about__animate--5">
        {stats.map((stat) => (
          <div class="about__stat">
            <span class="about__stat-value">{stat.value}</span>
            <span class="about__stat-label">{stat.label}</span>
          </div>
        ))}
      </div>

      <div class="about__credentials about__animate about__animate--6">
        <p class="about__cred-title">EDUCACIÓN Y CREDENCIALES</p>
        {credentialGroups.map((group) => (
          <div class="about__cred-group">
            <p class="about__cred-school">{group.institution}</p>
            <div class="about__cred-items">
              {group.items.map((cred) => (
                <div class="about__cred-row">
                  <span class="about__cred-name">{cred.title}</span>
                  {cred.year && <span class="about__cred-year">{cred.year}</span>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: #fff;
    padding: 7rem 2.5rem;
    position: relative;
    overflow: visible;
    border-top: 1px solid rgba(212, 175, 55, 0.4);
  }

  .about__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    gap: 5rem;
    align-items: flex-start;
    min-height: 900px;
  }

  .about__left {
    position: sticky;
    top: 96px;
    flex: 0 0 42%;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .about__img-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: visible;
    border: 1px solid #e8f0f4;
  }

  .about__img {
    width: 100%;
    height: auto;
    object-fit: unset;
    display: block;
    border-radius: 16px;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .about__img--stacked {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }

  .about__img--active {
    opacity: 1;
  }

  .about__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #1a6faa;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .about__arrow:hover {
    background: #1a6faa;
    color: #fff;
  }

  .about__arrow--prev {
    left: 1rem;
  }

  .about__arrow--next {
    right: 1rem;
  }

  .about__corner {
    position: absolute;
    width: 55px;
    height: 55px;
    z-index: 2;
  }

  .about__corner--tl {
    top: -14px;
    left: -14px;
    border-top: 3px solid #c07a50;
    border-left: 3px solid #c07a50;
    border-radius: 4px 0 0 0;
  }

  .about__corner--br {
    bottom: -14px;
    right: -14px;
    border-bottom: 3px solid #c07a50;
    border-right: 3px solid #c07a50;
    border-radius: 0 0 4px 0;
  }

  .about__badge {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: white;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .about__badge-dot {
    width: 8px;
    height: 8px;
    background: #1a6faa;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .about__badge-title {
    font-family: 'Georgia', serif;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: #1a6faa;
    font-weight: 600;
    margin: 0;
  }

  .about__badge-sub {
    font-family: 'Georgia', serif;
    font-size: 0.75rem;
    color: #2c4a5a;
    margin: 0;
  }

  .about__right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    padding-top: 5rem;
  }

  .about__label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: 'Georgia', serif;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: #c07a50;
    font-weight: 600;
    margin: 0;
  }

  .about__label-line {
    display: inline-block;
    width: 28px;
    height: 1.5px;
    background: #c07a50;
  }

  .about__title {
    font-family: 'Georgia', serif;
    font-size: clamp(2.8rem, 3.2vw, 4rem);
    font-weight: 700;
    color: #1a2f3a;
    line-height: 1.2;
    margin: 0;
  }

  .about__title-em {
    font-style: italic;
    font-weight: 400;
    color: #1a6faa;
  }

  .about__divider {
    width: 590px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(212, 175, 55, 0.6) 50%,
      transparent 100%
    );
    align-self: center;
  }

  .about__text {
    font-family: 'Georgia', serif;
    font-size: 1rem;
    color: #4a6070;
    line-height: 1.8;
    margin: 0;
  }

  .about__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .about__stat {
    background: #f4f9fb;
    border-radius: 12px;
    padding: 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .about__stat-value {
    font-family: 'Georgia', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #1a2f3a;
    line-height: 1;
  }

  .about__stat-label {
    font-family: 'Georgia', serif;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #7a9aaa;
    font-weight: 500;
  }

  .about__credentials {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .about__cred-title {
    font-family: 'Georgia', serif;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: #7a9aaa;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }

  .about__cred-group {
    display: grid;
    grid-template-columns: 190px 1fr;
    column-gap: 1.5rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid #f0f4f6;
  }

  .about__cred-group:last-child {
    border-bottom: none;
  }

  .about__cred-school {
    font-family: 'Georgia', serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: #1a6faa;
    line-height: 1.4;
    margin: 0;
  }

  .about__cred-items {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about__cred-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .about__cred-name {
    font-family: 'Georgia', serif;
    font-size: 0.9rem;
    color: #1a1a1a;
    line-height: 1.5;
  }

  .about__cred-year {
    font-family: 'Georgia', serif;
    font-size: 0.85rem;
    color: #9ab0bb;
    flex-shrink: 0;
  }

  /* ── Animaciones ── */
  .about__animate {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .about__animate--left {
    transform: translateX(-30px);
  }

  .about__animate--1 { transition-delay: 0.1s; }
  .about__animate--2 { transition-delay: 0.2s; }
  .about__animate--3 { transition-delay: 0.3s; }
  .about__animate--4 { transition-delay: 0.4s; }
  .about__animate--5 { transition-delay: 0.5s; }
  .about__animate--6 { transition-delay: 0.6s; }

  .about__animate.visible {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  /* ── Responsive ── */
  .about__right {
    min-width: 0;
  }

  .about__divider {
    max-width: 100%;
  }

  @media (max-width: 899px) {
    .about {
      padding: 4.5rem 1.5rem;
    }

    .about__container {
      flex-direction: column;
      gap: 2.5rem;
      min-height: 0;
    }

    .about__left {
      position: static;
      flex: none;
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      gap: 1.5rem;
    }

    .about__right {
      padding-top: 0;
      width: 100%;
    }

    .about__title {
      font-size: clamp(2rem, 6.5vw, 2.8rem);
    }
  }

  @media (max-width: 479px) {
    .about__cred-group {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
    }

    .about__stat {
      padding: 1.1rem 1.2rem;
    }

    .about__stat-value {
      font-size: 1.7rem;
    }
  }

  @media (max-width: 399px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const observerAbout = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observerAbout.unobserve(entry.target);
      }
    });
  }, { 
    threshold: 0,        /* ← antes 0.1, ahora dispara apenas aparece */
    rootMargin: '0px 0px -50px 0px'
  });

  document.querySelectorAll('.about__animate').forEach(el => observerAbout.observe(el));

  (() => {
    const imgs = document.querySelectorAll('.about__img');
    let current = 0;
    const show = (i) => {
      imgs[current].classList.remove('about__img--active');
      current = (i + imgs.length) % imgs.length;
      imgs[current].classList.add('about__img--active');
    };
    document.querySelector('.about__arrow--prev').addEventListener('click', () => show(current - 1));
    document.querySelector('.about__arrow--next').addEventListener('click', () => show(current + 1));
  })();
</script>